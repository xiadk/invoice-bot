# ── 凭据与登录态 —— 绝对不能提交/外发 ──
config.json
*.state.json

# ── 真实业务数据与运行产物 —— 不入库 ──
# data/ 下含真实订单/发票 Excel（公司名、税号）、平台状态快照、数据库备份、登录态、日志，
# 全部排除；仅保留目录占位 .gitkeep，克隆后把数据放回去即可运行。
data/*
!data/.gitkeep

# ── 临时脚本与临时备份（本地验证用，不入库）──
tmp-*.js
tmp-*.sql

# ── 本机便利脚本（提交/推送命令，仅本机使用，不入库）──
git-提交推送命令.sh

# ── 已废弃的浏览器扩展打包产物（扩展通道 2026-10-14 下线，改本机助手）──
invoice-bot-extension.zip
extension.zip

node_modules/

# ── 本机助手安装包构建产物（electron-builder 输出，体积大、不入库）──
dist/
release/

# ── 根目录杂散日志（本机运行/调试产物，不入库）──
/build.log
/npm-install.log
/server.log
# logs/ 是开发时 `node server.js >> logs/dev-8787.log` 的运行日志目录；容器里日志走 docker logs
/logs/
