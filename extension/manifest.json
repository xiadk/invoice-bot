{
  "manifest_version": 3,
  "name": "1688 发票催收 · 本机发送助手",
  "version": "1.0.0",
  "description": "在您自己的浏览器里完成 1688 催收消息发送；登录态与密码不离开本机。",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["*://*.1688.com/*", "*://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "1688 发票催收 · 本机发送助手"
  },
  "content_scripts": [
    {
      "matches": ["*://*.1688.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
